.vars
  .CUSTOM_TARGET_DIR: target-custom

.tasks

  .build
    .desc Builds in debug mode
    .cmd cargo build --workspace

  .build-custom
    .desc Builds in debug mode
    .cmd CARGO_TARGET_DIR={{CUSTOM_TARGET_DIR}} cargo build --workspace

  .clean
    .desc Cleans all targets
    .cmd cargo clean
    .cmd CARGO_TARGET_DIR={{CUSTOM_TARGET_DIR}} cargo clean

  .clippy
    .desc Runs clippy for all targets
    .cmd cargo clippy --all-targets --workspace

  .cov
    .desc Generates the code coverage report for cli-assert crate
    .cmd cargo llvm-cov clean
    .cmd cargo llvm-cov --no-cfg-coverage --workspace --dep-coverage cli-assert

  .cov-html
    .desc Generates the code coverage report for cli-assert crate
    .cmd cargo llvm-cov clean
    .cmd cargo llvm-cov --no-cfg-coverage --workspace --dep-coverage cli-assert --html

  .cov-html-open
    .desc Generates the code coverage report for cli-assert crate
    .cmd cargo llvm-cov clean
    .cmd cargo llvm-cov --no-cfg-coverage --workspace --dep-coverage cli-assert --html --open

  .cov-badge
    .desc Generates the detailed code coverage badge
    .cmd cargo +stable llvm-cov clean
    .cmd cargo +stable llvm-cov --no-cfg-coverage --workspace --dep-coverage cli-assert --json --summary-only | coverio -l coverage -c --tag cov-badge -f ../cli-assert/README.md

  .cov-local
    .desc Generates the code coverage report for cli-assert crate
    .cmd cargo llvm-cov clean
    .cmd cargo llvm-cov --no-cfg-coverage --workspace

  .cov-local-html
    .desc Generates the code coverage report for cli-assert crate
    .cmd cargo llvm-cov clean
    .cmd cargo llvm-cov --no-cfg-coverage --workspace --html

  .cov-local-html-open
    .desc Generates the code coverage report for cli-assert crate
    .cmd cargo llvm-cov clean
    .cmd cargo llvm-cov --no-cfg-coverage --workspace --html --open

  .fmt
    .desc Runs code formatter
    .cmd cargo +nightly fmt

  .test
    .desc Runs tests in debug mode
    .cmd cargo test --workspace

  .testn
    .desc Runs tests in debug mode
    .cmd cargo nextest run --workspace

  .test-custom
    .desc Runs tests in debug mode with custom output directory
    .cmd CARGO_TARGET_DIR={{CUSTOM_TARGET_DIR}} cargo test --workspace

  .testn-custom
    .desc Runs tests in debug mode with custom output directory
    .cmd CARGO_TARGET_DIR={{CUSTOM_TARGET_DIR}} nextest run --workspace
